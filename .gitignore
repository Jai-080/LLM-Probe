# Virtual environment — use .venv/ for new installs
# llm_probe/ was the old venv directory (pre-refactor); kept ignored so git
# does not suddenly surface the venv contents if it still exists locally.
/llm_probe/
venv/
.venv/
Env/

# Python cache and temporary files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/

# Exclude large checkpoint/cache files that exceed GitHub's 100MB size limit
*.pkl
*.env

# setuptools editable-install build artifact (regenerated by pip install -e .)
*.egg-info/

graphify-out
extracted_paper.txt
